<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" href="/Icon.jpeg" type="image/x-icon">
    <title>Weathera</title>
</head>
<body>
    <div class="header">
        <div id="Title-container">
            <h1 id="title">Weathera</h1>
        </div>
        <div id="Input-container">
            <form action="/" method="POST">
                <input type="text" name="city" placeholder="Enter your city..." required class="text-input">
            </form>
        </div>
    </div>
    <div class="container">
        <% if (weather) { %>

            <div class="weatherInfo">
                <div class="weatherHeader">
                    <img id="weatherIcon" src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png" alt="<%= weather.description %>">
                    <h3>
                        Weather in
                        <span id="place">
                            <%= weather.city %>, <%= weather.country %>
                        </span>
                    </h3>
                </div>

                <div class="weatherGrid">
                    <p><i class="fa-solid fa-temperature-half"></i><span><span class="label">Temperature</span><span class="value"><span id="temperature"><%= weather.temperature %></span>°C</span></span></p>
                    <p><i class="fa-solid fa-temperature-low"></i><span><span class="label">Min Temperature</span><span class="value"><span id="MinTemp"><%= weather.MinTemp %></span>°C</span></span></p>
                    <p><i class="fa-solid fa-temperature-high"></i><span><span class="label">Max Temperature</span><span class="value"><span id="MaxTemp"><%= weather.MaxTemp %></span>°C</span></span></p>
                    <p><i class="fa-solid fa-person"></i><span><span class="label">Feels Like</span><span class="value"><span id="feelsLike"><%= weather.feelsLike %></span>°C</span></span></p>
                    <p><i class="fa-solid fa-gauge"></i><span><span class="label">Pressure</span><span class="value"><span id="pressure"><%= weather.pressure %></span> hPa</span></span></p>

                    <% if (weather.visibility >= 10000) { %>
                        <p><i class="fa-solid fa-eye"></i><span><span class="label">Visibility</span><span class="value" id="visibility">infinite</span></span></p>
                    <% } else { %>
                        <p><i class="fa-solid fa-eye"></i><span><span class="label">Visibility</span><span class="value" id="visibility"><%= weather.visibility %> meters</span></span></p>
                    <% } %>

                    <p><i class="fa-solid fa-compass"></i><span><span class="label">Wind Direction</span><span class="value"><span id="windDeg"><%= weather.windDeg %></span>° <span id="windDir"><%= weather.windDir %></span></span></span></p>
                    <p><i class="fa-solid fa-cloud"></i><span><span class="label">Description</span><span class="value" id="description"><%= weather.description %></span></span></p>
                    <p><i class="fa-solid fa-droplet"></i><span><span class="label">Humidity</span><span class="value"><span id="humidity"><%= weather.humidity %></span>%</span></span></p>
                    <p><i class="fa-solid fa-wind"></i><span><span class="label">Wind Speed</span><span class="value"><span id="wind"><%= weather.wind %></span> m/s</span></span></p>
                </div>
            </div>

            <div id="map"></div>

            <% if (forecast) { %>
                <div class="forecast">
                    <% forecast.forEach(day => { %>
                        <div class="forecastDay">
                            <p><b><%= day.day %></b></p>
                            <img src="https://openweathermap.org/img/wn/<%= day.icon %>@2x.png" alt="<%= day.description %>">
                            <p><%= day.description %></p>
                            <p><%= Math.round(day.maxTemp) %>° / <%= Math.round(day.minTemp) %>°</p>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <script>
                const map = L.map('map').setView([<%= weather.lat %>, <%= weather.lon %>], 11);

                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                const marker = L.marker([<%= weather.lat %>, <%= weather.lon %>])
                    .addTo(map)
                    .bindPopup(`<b><%= weather.city %></b><br><%= weather.temperature %>°C, <%= weather.description %>`)
                    .openPopup();

                function showWeather(w) {
                    const place = w.city ? (w.country ? `${w.city}, ${w.country}` : w.city) : 'Unknown place';
                    document.getElementById('place').textContent = place;
                    document.getElementById('temperature').textContent = w.temperature;
                    document.getElementById('MinTemp').textContent = w.MinTemp;
                    document.getElementById('MaxTemp').textContent = w.MaxTemp;
                    document.getElementById('feelsLike').textContent = w.feelsLike;
                    document.getElementById('pressure').textContent = w.pressure;
                    document.getElementById('visibility').textContent = w.visibility >= 10000 ? 'infinite' : `${w.visibility} meters`;
                    document.getElementById('windDeg').textContent = w.windDeg;
                    document.getElementById('windDir').textContent = w.windDir;
                    document.getElementById('description').textContent = w.description;
                    document.getElementById('humidity').textContent = w.humidity;
                    document.getElementById('wind').textContent = w.wind;
                    document.getElementById('weatherIcon').src = `https://openweathermap.org/img/wn/${w.icon}@2x.png`;
                    document.getElementById('weatherIcon').alt = w.description;
                    return place;
                }

                function showForecast(days) {
                    const forecast = document.querySelector('.forecast');
                    if (!forecast || !days) return;
                    forecast.innerHTML = days.map(day => `
                        <div class="forecastDay">
                            <p><b>${day.day}</b></p>
                            <img src="https://openweathermap.org/img/wn/${day.icon}@2x.png" alt="${day.description}">
                            <p>${day.description}</p>
                            <p>${Math.round(day.maxTemp)}° / ${Math.round(day.minTemp)}°</p>
                        </div>
                    `).join('');
                }

                map.on('click', async (e) => {
                    const { lat, lng } = e.latlng.wrap();
                    marker.setLatLng(e.latlng);
                    marker.setPopupContent('Loading...').openPopup();

                    try {
                        const res = await fetch(`/weather?lat=${lat}&lon=${lng}`);
                        const data = await res.json();
                        if (!res.ok) throw new Error(data.error);
                        const place = showWeather(data);
                        showForecast(data.forecast);
                        marker.setPopupContent(`<b>${place}</b><br>${data.temperature}°C, ${data.description}`);
                    } catch (err) {
                        marker.setPopupContent('Could not get weather here');
                    }
                });
            </script>
        <% } %>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

    </div>

    <footer>
        <p id="copyright">&copy; Weathera</p>
    </footer>
</body>
</html>

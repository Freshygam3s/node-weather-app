<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <title>Weathera</title>
</head>
<body>
    <div class="header">
        <div id="Title-container">
            <h1 id="title">Weathera</h1>
        </div>
        <div id="Input-container">
            <form action="/" method="POST">
                <input type="text" name="city" placeholder="Enter your city..." required class="text-input">
            </form>
        </div>
    </div>
    <div class="container">
        <% if (weather) { %>

            <div class="weatherInfo">
                <h3>
                    Weather in
                    <span id="place">
                        <%= weather.city %>, <%= weather.country %>
                    </span>
                </h3>

                <div class="weatherGrid">
                    <p>Temperature: <span id="temperature"><%= weather.temperature %></span>°C</p>
                    <p>Min Temperature: <span id="MinTemp"><%= weather.MinTemp %></span>°C</p>
                    <p>Max Temperature: <span id="MaxTemp"><%= weather.MaxTemp %></span>°C</p>
                    <p>Feels Like: <span id="feelsLike"><%= weather.feelsLike %></span>°C</p>
                    <p>Pressure: <span id="pressure"><%= weather.pressure %></span> hPa</p>

                    <% if (weather.visibility >= 10000) { %>
                        <p>Visibility: <span id="visibility">infinite</span></p>
                    <% } else { %>
                        <p>Visibility: <span id="visibility"><%= weather.visibility %> meters</span></p>
                    <% } %>

                    <p>Wind Direction: <span id="windDeg"><%= weather.windDeg %></span>°</p>
                    <p>Description: <span id="description"><%= weather.description %></span></p>
                    <p>Humidity: <span id="humidity"><%= weather.humidity %></span>%</p>
                    <p>Wind speed: <span id="wind"><%= weather.wind %></span> m/s</p>
                </div>

                <% if (forecast) { %>
    <div class="forecast">
        <% forecast.forEach(day => { %>
            <div class="forecastDay">
                <p><b><%= day.day %></b></p>
                <p><%= day.description %></p>
                <p><%= Math.round(day.max) %>° / <%= Math.round(day.min) %>°</p>
            </div>
        <% }) %>
    </div>
<% } %>
            </div>

            <div id="map"></div>

            <script>
                const map = L.map('map').setView([<%= weather.lat %>, <%= weather.lon %>], 11);

                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                const marker = L.marker([<%= weather.lat %>, <%= weather.lon %>])
                    .addTo(map)
                    .bindPopup(`<b><%= weather.city %></b><br><%= weather.temperature %>°C, <%= weather.description %>`)
                    .openPopup();

                function showWeather(w) {
                    const place = w.city ? (w.country ? `${w.city}, ${w.country}` : w.city) : 'Unknown place';
                    document.getElementById('place').textContent = place;
                    document.getElementById('temperature').textContent = w.temperature;
                    document.getElementById('MinTemp').textContent = w.MinTemp;
                    document.getElementById('MaxTemp').textContent = w.MaxTemp;
                    document.getElementById('feelsLike').textContent = w.feelsLike;
                    document.getElementById('pressure').textContent = w.pressure;
                    document.getElementById('visibility').textContent = w.visibility >= 10000 ? 'infinite' : `${w.visibility} meters`;
                    document.getElementById('windDeg').textContent = w.windDeg;
                    document.getElementById('description').textContent = w.description;
                    document.getElementById('humidity').textContent = w.humidity;
                    document.getElementById('wind').textContent = w.wind;
                    return place;
                }

                map.on('click', async (e) => {
                    const { lat, lng } = e.latlng.wrap();
                    marker.setLatLng(e.latlng);
                    marker.setPopupContent('Loading...').openPopup();

                    try {
                        const res = await fetch(`/weather?lat=${lat}&lon=${lng}`);
                        const data = await res.json();
                        if (!res.ok) throw new Error(data.error);
                        const place = showWeather(data);
                        marker.setPopupContent(`<b>${place}</b><br>${data.temperature}°C, ${data.description}`);
                    } catch (err) {
                        marker.setPopupContent('Could not get weather here');
                    }
                });
            </script>
        <% } %>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

    </div>

    <footer>
        <p id="copyright">&copy; Weathera</p>
    </footer>
</body>
</html>
